// Version resources: app icon + Per-Monitor-V2 manifest
1 ICON "..\\resources\\icons\\icon.ico"
1 24 "app.manifest"

// 版本资源：让任务管理器“名称”列显示友好名 “Clash Win” 而非原始镜像名 “clashwin.exe”。
// 版本号以 include/clashwin/config/constants.h:20 的 kAppVersion 为唯一事实来源，
// 此处数值/字符串需与之同步（每次 bump 时一并改）。
// 1:1 对齐 Clash Mini：Mini 主程序 FileDescription 为 “Clash Mini”，Win 对应为 “Clash Win”。
1 VERSIONINFO
FILEVERSION 0,2,10,0
PRODUCTVERSION 0,2,10,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ClashWin"
            VALUE "FileDescription", "Clash Win"
            VALUE "FileVersion", "0.2.10"
            VALUE "InternalName", "clashwin"
            VALUE "OriginalFilename", "clashwin.exe"
            VALUE "ProductName", "Clash Win"
            VALUE "ProductVersion", "0.2.10"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
